# SQLite locally. For Postgres: switch datasource provider in prisma/schema.prisma
# and use postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Stripe. Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# No trailing slash. Used for Stripe redirects, OG images and canonical URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Any long random string. Lets POST /api/admin/hide hide a listing.
ADMIN_KEY="change-me"
